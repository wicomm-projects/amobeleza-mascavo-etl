# Copie para .env (que fica fora do Git). Só NOMES aqui: nenhuma chave real neste arquivo.
# Fonte sem chave = "aguardando chave" (o processo continua). Grupo preenchido pela metade = erro na subida.
# O usuário root NUNCA é usado, nem no banco local nem no da cliente.

NODE_ENV=development
LOG_LEVEL=info

# Servidor de status (Express): só loopback.
HOST=127.0.0.1
PORT=3000

# Agendador interno. Desligado até a liberação de cada fonte.
SCHEDULER_ENABLED=false

# Destino das cargas. TARGET_MODE=local (padrão): MySQL LOCAL do docker-compose. TARGET_MODE=production: só na VPS,
# só o banco da cliente de src/config/production-target.ts com o usuário wicomm_etl (docs/runbooks/vps.md, seção 9).
TARGET_MODE=local
TARGET_DB_HOST=127.0.0.1
TARGET_DB_PORT=3307
TARGET_DB_USER=etl_local
TARGET_DB_PASSWORD=etl_local_dev
# Bancos em que o ETL pode gravar (separados por vírgula). Vazio não vale; sem a linha, os dois. Na virada só da
# Mascavo, a VPS usa só mascavo_etl: o agendador ignora os jobs da Amobeleza e o AnyMarket, e o run recusa gravar neles.
TARGET_DATABASES=mascavo_etl,amobeleza_etl
# Jobs que podem gravar ("job", "job:marca" ou "*"), além do banco. Sem a linha, todos os jobs dos bancos liberados.
# Vazio não vale. Em produção com amobeleza_etl em TARGET_DATABASES, TARGET_JOBS e ANYMARKET_ACCOUNTS são obrigatórios.
# Mascavo + AnyMarket da conta MASCAVO, sem ligar VTEX e GA4 da Amobeleza:
# TARGET_JOBS=vtex-orders:mascavo,vtex-catalog:mascavo,ga4:mascavo,anymarket-orders
# Contas do AnyMarket gravadas (accountName, sem diferença de maiúscula, ou "*"). Sem a linha, todas. Vazio não vale.
# ANYMARKET_ACCOUNTS=MASCAVO
# Senha do root do MySQL local, lida só pelo docker-compose (o ETL nunca usa). Vazio = padrão fraco de desenvolvimento;
# na VPS, preencher antes do primeiro `npm run db:up` (o MySQL só usa essa senha ao criar o banco). Sem caractere
# especial: o leitor de .env do Docker é mais rígido que o do ETL.
LOCAL_MYSQL_ROOT_PASSWORD=

# Banco de REFERÊNCIA (MySQL da cliente), SÓ LEITURA, via túnel SSH pela VPS. Vazio até a cliente criar o usuário.
REF_DB_HOST=
REF_DB_PORT=3306
REF_DB_USER=
REF_DB_PASSWORD=
REF_DB_MAX_EXECUTION_MS=30000

# VTEX (fase 1) — AppKey/AppToken só de leitura de cada loja.
VTEX_MASCAVO_ACCOUNT=
VTEX_MASCAVO_ENVIRONMENT=vtexcommercestable
VTEX_MASCAVO_APP_KEY=
VTEX_MASCAVO_APP_TOKEN=
VTEX_AMOBELEZA_ACCOUNT=
VTEX_AMOBELEZA_ENVIRONMENT=vtexcommercestable
VTEX_AMOBELEZA_APP_KEY=
VTEX_AMOBELEZA_APP_TOKEN=

# GA4 (fase 3) — ID numérico da propriedade de cada marca + caminho do JSON da conta de serviço (FORA do repo).
GA4_MASCAVO_PROPERTY_ID=
GA4_AMOBELEZA_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# AnyMarket (fase 6) — token de produção cobrindo todas as contas.
ANYMARKET_BASE_URL=https://api.anymarket.com.br/v2
ANYMARKET_TOKEN=

# Cliente HTTP (VTEX, AnyMarket)
HTTP_TIMEOUT_MS=30000
HTTP_MAX_ATTEMPTS=4
HTTP_CONCURRENCY=4
